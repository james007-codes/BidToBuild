+      "id": "library", "name": "Library Building",
+      "floors": [
+        { "id": "lib-0", "name": "Ground Floor", "rooms": [
+          { "id": "lib-reading", "name": "Reading Hall", "roomType": "Library" },
+          { "id": "lib-digital", "name": "Digital Library", "roomType": "Computer Lab" }
+        ]}
+      ]
+    },
+    {
+      "id": "canteen-block", "name": "Canteen Block",
+      "floors": [
+        { "id": "cb-0", "name": "Ground Floor", "rooms": [
+          { "id": "main-canteen", "name": "Main Canteen", "roomType": "Canteen" },
+          { "id": "canteen-kitchen", "name": "Canteen Kitchen", "roomType": "Canteen" },
+          { "id": "cb-water", "name": "Canteen Water Point", "roomType": "Common Area" }
+        ]}
+      ]
+    },
+    {
+      "id": "auditorium", "name": "Auditorium",
+      "floors": [
+        { "id": "aud-0", "name": "Ground Floor", "rooms": [
